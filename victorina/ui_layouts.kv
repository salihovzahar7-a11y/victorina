#:kivy 2.3.0
#:import hex kivy.utils.get_color_from_hex

<ThemedScreen>:
    canvas.before:
        Color:
            rgba: app.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

<MenuScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "15dp"

        Label:
            text: "Викторины"
            font_size: "32sp"
            bold: True
            color: app.text_color
            size_hint_y: None
            height: "60dp"

        Button:
            text: "Играть"
            font_size: "20sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: app.root.current = "quiz_list"

        Button:
            text: "Рекорды"
            font_size: "20sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: app.root.current = "records"

        Button:
            text: "Настройки"
            font_size: "20sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: app.root.current = "settings"

<QuizListScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "10dp"
        spacing: "10dp"

        Label:
            text: "Выберите тему:"
            font_size: "24sp"
            bold: True
            color: app.text_color
            size_hint_y: None
            height: "50dp"

        ScrollView:
            BoxLayout:
                id: quiz_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "5dp"

<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "15dp"

        Label:
            text: "Настройки"
            font_size: "28sp"
            bold: True
            color: app.text_color
            size_hint_y: None
            height: "50dp"

        Button:
            id: theme_btn
            text: "Тёмная тема"
            font_size: "18sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: root.toggle_theme()

        Label:
            id: qcount_label
            text: "Количество вопросов: 10"
            font_size: "18sp"
            color: app.text_color
            size_hint_y: None
            height: "40dp"

        Slider:
            id: qcount_slider
            min: 5
            max: 15
            value: 10
            step: 1
            on_value: root.change_qcount(self.value)

        Label:
            text: "5 - минимум, 15 - максимум"
            font_size: "14sp"
            color: app.text_color
            size_hint_y: None
            height: "30dp"

        Button:
            text: "Назад"
            font_size: "18sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: app.root.current = "menu"

<RecordsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "10dp"
        spacing: "10dp"

        Label:
            text: "Таблица рекордов"
            font_size: "24sp"
            bold: True
            color: app.text_color
            size_hint_y: None
            height: "50dp"

        ScrollView:
            BoxLayout:
                id: records_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "2dp"

        Button:
            text: "Назад"
            font_size: "18sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: app.root.current = "menu"

<QuizScreen>:
    quiz_title: ""
    BoxLayout:
        orientation: "vertical"
        padding: "15dp"
        spacing: "10dp"

        Label:
            id: score_label
            text: "Очки: 0 (x1)"
            font_size: "18sp"
            bold: True
            color: app.accent_color
            size_hint_y: None
            height: "30dp"
            text_size: self.width, None

        Label:
            id: qtext
            text: "Вопрос"
            font_size: "20sp"
            color: app.text_color
            size_hint_y: None
            height: "120dp"
            text_size: self.width, None
            valign: "top"

        Button:
            id: a1
            text: "Ответ 1"
            font_size: "16sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: root.answer(self)
            size_hint_y: None
            height: "60dp"

        Button:
            id: a2
            text: "Ответ 2"
            font_size: "16sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: root.answer(self)
            size_hint_y: None
            height: "60dp"

        Button:
            id: a3
            text: "Ответ 3"
            font_size: "16sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: root.answer(self)
            size_hint_y: None
            height: "60dp"

        Button:
            id: a4
            text: "Ответ 4"
            font_size: "16sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: root.answer(self)
            size_hint_y: None
            height: "60dp"

<ResultScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "20dp"

        Label:
            id: result_label
            text: "Результаты"
            font_size: "22sp"
            color: app.text_color
            text_size: self.width, None
            valign: "middle"

        Button:
            text: "В меню"
            font_size: "20sp"
            background_color: app.button_bg
            color: app.button_text
            on_release: app.root.current = "menu"

        Button:
            text: "Играть снова"
            font_size: "20sp"
            background_color: app.accent_color
            color: app.button_text
            on_release: app.root.current = "quiz_list"